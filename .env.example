NODE_ENV=development
PORT=3100

# Internal FUDmarkets API. The agent never receives DATABASE_URL, JWT_SECRET,
# treasury keys, user wallet keys or the V2 operator key.
FUD_ENGINE_URL=http://localhost:3001
FUD_AGENT_SERVICE_ID=fud-agent-local
FUD_AGENT_SHARED_SECRET=replace-with-at-least-32-random-bytes

# Provider ingress secrets. Enable a channel only after configuring its secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
X_WEBHOOK_SECRET=

# Optional agent delegate. Use a dedicated Ed25519 SIGN_VERIFY KMS key.
AGENTIC_DELEGATE_SOL_KMS_KEY_ID=
AWS_REGION=

