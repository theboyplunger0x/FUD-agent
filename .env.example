NODE_ENV=development
PORT=3100

# Internal FUDmarkets API. The agent never receives DATABASE_URL, JWT_SECRET,
# treasury keys, user wallet keys or the V2 operator key.
FUD_ENGINE_URL=http://localhost:3001
FUD_AGENT_SERVICE_ID=fud-agent-local
FUD_AGENT_SHARED_SECRET=replace-with-at-least-32-random-bytes

# Provider ingress secrets. Enable a channel only after configuring its secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
X_WEBHOOK_SECRET=

# Reserved for the X adapter extraction. These are not consumed by src/ yet.
# twitterapi.io is the read/discovery provider. The X_BOT_* application is the
# official read/write app used only by @FUDmarkets to publish replies.
TWITTERAPI_KEY=
X_BOT_API_KEY=
X_BOT_API_SECRET=
X_BOT_ACCESS_TOKEN=
X_BOT_ACCESS_TOKEN_SECRET=

# Optional browser-session fallback for proactive replies. The cookie/session
# state belongs to the isolated x-poster service and must never be committed.
X_POSTER_URL=
X_POSTER_SECRET=

# Optional X ingestion/automation controls.
X_MENTION_POLL_MS=300000
X_QUOTES_ENABLED=0
X_QUOTE_POLL_MS=600000
X_REPLY_AGENT_ENABLED=0
ENABLE_PROACTIVE_REPLIES=false

# Optional copy generation and Telegram approval routing.
ANTHROPIC_API_KEY=
ADMIN_TG_ID=
ADMIN_TG_ID_2=
BOT_REPLY_MEDIA_URL=
